{
    "name": "laragear/attempt-once",
    "description": "Run and manage callbacks across multiple app instances",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Italo Baeza C.",
            "email": "DarkGhostHunter@Gmail.com",
            "homepage": "https://github.com/DarkGhostHunter"
        }
    ],
    "support": {
        "source": "https://github.com/Laragear/AttemptOnce",
        "issues": "https://github.com/Laragear/AttemptOnce/issues"
    },
    "require": {
        "php": "^8.4",
        "laragear/meta": "^4.0.0",
        "laragear/meta-model": "^2.0.0 || ^3.0.0"
    },
    "require-dev": {
        "laragear/meta-testing": "3.*",
        "orchestra/testbench": "^9.16|10.*"
    },
    "autoload": {
        "psr-4": {
            "Laragear\\AttemptOnce\\": "src"
        },
        "files": [
            "helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --coverage-clover build/logs/clover.xml",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "funding": [
        {
            "type": "Github Sponsorship",
            "url": "https://github.com/sponsors/DarkGhostHunter"
        },
        {
            "type": "Paypal",
            "url": "https://paypal.me/darkghosthunter"
        }
    ]
}
